# MongoDB connection string for the main database
MONGODB_URI=

# Optional dedicated MongoDB connection URI for running tests
MONGODB_URI_TEST=

# Production database name guard to ensure test suites never write to production
MONGODB_URI_PROD_DB=

# Secret key used for signing JWT session tokens and device cookies
AUTH_SECRET=

# 32-byte hex encryption key used for student credential encryption at rest
CREDENTIAL_ENC_KEY=

# Optional secondary encryption key for rotating credential encryption
CREDENTIAL_ENC_KEY_V2=

# Initial administrator login identifier for seed scripts
ADMIN_LOGIN_ID=

# Initial administrator password for seed scripts
ADMIN_PASSWORD=

# Contact/notification email for the administrator
ADMIN_EMAIL=

# Canonical public application URL used in outbound email templates and redirect links
NEXT_PUBLIC_APP_URL=

# Public website base URL for canonical tags, sitemaps, and metadata
NEXT_PUBLIC_SITE_URL=

# Flag (1/0) to force CSS and Framer/motion animations regardless of prefers-reduced-motion
NEXT_PUBLIC_FORCE_MOTION=

# Outbound email provider driver (smtp, resend, or console)
EMAIL_DRIVER=

# Default sender email address for outgoing system emails
EMAIL_FROM=

# Default sender display name for outgoing system emails
EMAIL_FROM_NAME=

# Fallback sender email address for system emails
EMAIL_FROM_ADDRESS=

# Maximum allowed outgoing emails per 24-hour window
EMAIL_DAILY_LIMIT=

# SMTP server hostname (e.g. smtp.gmail.com)
SMTP_HOST=

# SMTP server port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=

# SMTP authentication username or account email
SMTP_USER=

# SMTP authentication password or Gmail App Password
SMTP_PASS=

# API key for Resend email driver (if EMAIL_DRIVER=resend)
RESEND_API_KEY=

# Set to true to permit console email driver fallback when running in production
ALLOW_CONSOLE_EMAIL_IN_PROD=

# Upload storage backend (local, vercel_blob, or cloudinary)
STORAGE_DRIVER=

# Read/write token for Vercel Blob storage (if STORAGE_DRIVER=vercel_blob)
BLOB_READ_WRITE_TOKEN=

# Cloudinary cloud name for lecture/notes image hosting
CLOUDINARY_CLOUD_NAME=

# Cloudinary API key for lecture/notes image hosting
CLOUDINARY_API_KEY=

# Cloudinary API secret for lecture/notes image hosting
CLOUDINARY_API_SECRET=

# Vimeo API access token with private video embed and folder read scopes
VIMEO_ACCESS_TOKEN=

# Node runtime environment (development, test, or production)
NODE_ENV=

# Local HTTP server port override
PORT=
