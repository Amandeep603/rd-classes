# MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/rdclasses?retryWrites=true&w=majority

# Auth Secret for session hashing and device HMAC (min 32 characters)
AUTH_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# Vimeo Access Token for lecture metadata auto-fetching (optional)
VIMEO_ACCESS_TOKEN=

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial Admin credentials (used only by npm run seed:admin)
ADMIN_LOGIN_ID=admin
ADMIN_PASSWORD=change_this_admin_password_123

# Test database URI (optional fallback when mongodb-memory-server is unavailable)
MONGODB_URI_TEST=
